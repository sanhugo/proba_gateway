# Скопируйте в .env (он в .gitignore) и при необходимости поменяйте значения.
# docker compose читает .env автоматически; Gateway, запущенный на хосте, - нет:
# передайте переменные через Run Configuration в IDE или окружение shell.

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# Секрет клиента gateway. Подставляется в keycloak/realm/*.json как ${KEYCLOAK_CLIENT_SECRET}
# и читается Gateway (обязательная переменная, значения по умолчанию в application.yaml нет).
KEYCLOAK_CLIENT_SECRET=gateway-dev-secret

# Пароль тестовых пользователей, которых создаёт keycloak/realm/proba-realm.json.
# Только для локальной разработки: этот realm-файл не импортировать на dev/prod.
TEST_USER_PASSWORD=change-me-test-users

# --- Redis (сессии с токенами) ---
# Обязателен для compose и Gateway, значения по умолчанию нет. Для прода - длинный случайный:
#   openssl rand -base64 32
REDIS_PASSWORD=change-me-redis

# --- Gateway ---
# Профиль: local (по умолчанию), dev или prod
# SPRING_PROFILES_ACTIVE=local
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/proba

# Только для dev/prod (в local не нужны):
# REDIS_HOST=redis.dev.internal
# REDIS_SSL=true            # в prod TLS включён всегда
# EXAMPLE_SERVICE_URL=http://example-service:8082
